<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="4dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/key_q" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Q" android:backgroundTint="#1C1C1E" android:textColor="white"/>
        <Button android:id="@+id/key_w" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="W" android:backgroundTint="#1C1C1E" android:textColor="white"/>
        <Button android:id="@+id/key_e" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="E" android:backgroundTint="#1C1C1E" android:textColor="white"/>
        <Button android:id="@+id/key_r" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="R" android:backgroundTint="#1C1C1E" android:textColor="white"/>
        <Button android:id="@+id/key_t" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="T" android:backgroundTint="#1C1C1E" android:textColor="white"/>
        <Button android:id="@+id/key_y" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Y" android:backgroundTint="#1C1C1E" android:textColor="white"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
        <Button android:id="@+id/key_a" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="A" android:backgroundTint="#1C1C1E" android:textColor="white"/>
        <Button android:id="@+id/key_s" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="S" android:backgroundTint="#1C1C1E" android:textColor="white"/>
        <Button android:id="@+id/key_d" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="D" android:backgroundTint="#1C1C1E" android:textColor="white"/>
        <Button android:id="@+id/key_f" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="F" android:backgroundTint="#1C1C1E" android:textColor="white"/>
        <Button android:id="@+id/key_del" android:layout_width="0dp" android:layout_weight="1.5" android:layout_height="48dp" android:text="⌫" android:backgroundTint="#2C2C2E" android:textColor="white"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
        <Button android:id="@+id/key_space" android:layout_width="0dp" android:layout_weight="1" android:layout_height="54dp" android:text="ESPACE  ← glisse →" android:backgroundTint="#2C2C2E" android:textColor="#AAAAAA" android:textSize="12sp"/>
        <Button android:id="@+id/key_enter" android:layout_width="80dp" android:layout_height="54dp" android:text="↵" android:backgroundTint="#0A84FF" android:textColor="white" android:layout_marginStart="6dp"/>
    </LinearLayout>
</LinearLayout>